{
  "expo": {
    "name": "RuneKeep",
    "slug": "RuneKeep",
    "version": "0.42.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "runekeep",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0E13",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "androidStatusBar": {
      "backgroundColor": "#0B0E13",
      "barStyle": "light-content",
      "translucent": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#0B0E13",
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.davidmgdev.runekeep",
      "backgroundColor": "#0B0E13",
      "adaptiveIcon": {
        "backgroundColor": "#0B0E13",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/octet-stream"
            },
            {
              "scheme": "content",
              "mimeType": "application/rkp"
            },
            {
              "scheme": "content",
              "mimeType": "application/x-rkp"
            },
            {
              "scheme": "content",
              "mimeType": "application/rune"
            },
            {
              "scheme": "content",
              "mimeType": "application/x-rune"
            }
          ]
        },
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "*/*",
              "pathPattern": ".*\\\\.rune"
            },
            {
              "scheme": "content",
              "host": "*",
              "mimeType": "*/*",
              "pathPattern": ".*\\\\.rune"
            },
            {
              "scheme": "file",
              "host": "*",
              "mimeType": "*/*",
              "pathPattern": ".*\\\\.rkp"
            },
            {
              "scheme": "content",
              "host": "*",
              "mimeType": "*/*",
              "pathPattern": ".*\\\\.rkp"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0E13",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 210
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-asset",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": [],
          "disableFFmpeg": true
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "RuneKeep uses NFC to share cards and expansions by tapping phones together."
        }
      ],
      "./plugins/withNfcHce"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
