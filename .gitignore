# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Python cache (scripts/)
__pycache__/
*.pyc

# Headless render / scratch
.rk-export/

# Web export scratch / screenshots
.rk-web*/

# all web-render scratch
.rk-*

# Card LOD thumbs are build artifacts - regenerate with python scripts/generate_lods.py
assets/extracted_cards/**/*_lod.webp

# Local-only rulebook reference scratch (licensed; transcribe to data, NEVER push)
assets/temp/
scripts/_class_pages.txt
scripts/_class_data.json
scripts/_features_full.txt

# stray editor/calibration backups
*.bak

# build logs (transient)
apk-build/*.log
