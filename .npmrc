# Install the way this project actually resolves (v0.43.0).
#
# `react-native-audio-api@0.12.2` declares an OPTIONAL peer on `react-native-worklets >= 0.6.0`, and
# this project is pinned to `react-native-worklets@0.5.1` because that is what `react-native-reanimated
# @4.1.x` accepts (`0.5 - 0.8`). The two cannot both be satisfied, and the app works: audio-api's use
# of worklets is optional, which is why the peer is marked optional in the first place.
#
# npm 11 (what this machine has) shrugs at an unsatisfiable OPTIONAL peer and installs. npm 10 (what
# Cloudflare Pages' build image has) treats it as a hard conflict and stops:
#
#   npm error ERESOLVE could not resolve
#   npm error Conflicting peer dependency: react-native-worklets@0.11.4
#
# So the site build failed at `npm clean-install`, before any of our own code ran, on a repo that
# installs perfectly here. This file is what makes the two agree, and it belongs in the repo rather
# than in a Cloudflare dashboard setting, because the constraint is a fact about the dependency tree
# and not about one host.
#
# Remove it when audio-api widens that range or reanimated accepts a newer worklets.
legacy-peer-deps=true
